# Groq API Configuration (get key from https://console.groq.com)
GROQ_API_KEY=

# Sarvam AI API Keys (get key from Sarvam AI)
SARVAM_API_KEY=
# STT language: unknown (auto-detect), en, hi, etc.
SARVAM_LANGUAGE_CODE=unknown
# Sarvam TTS voice configuration (Bulbul v3).
# Default: Simran (female, Indian accent) at slightly faster pace.
# Valid pace range is roughly 0.5–2.0; 1.0 = normal speed.
SARVAM_TTS_SPEAKER=simran
SARVAM_TTS_PACE=1.25
# Optional per-language TTS overrides. Leave blank to use global speaker/pace.
SARVAM_TTS_SPEAKER_EN_IN=
SARVAM_TTS_SPEAKER_HI_IN=
SARVAM_TTS_SPEAKER_KN_IN=
SARVAM_TTS_SPEAKER_TA_IN=
SARVAM_TTS_SPEAKER_TE_IN=
SARVAM_TTS_SPEAKER_ML_IN=
SARVAM_TTS_PACE_EN_IN=
SARVAM_TTS_PACE_HI_IN=
SARVAM_TTS_PACE_KN_IN=
SARVAM_TTS_PACE_TA_IN=
SARVAM_TTS_PACE_TE_IN=
SARVAM_TTS_PACE_ML_IN=
# Auto language detect from first transcript (supported: en/hi/kn/ta/te/ml)
AUTO_LANGUAGE_DETECT_ENABLED=true
AUTO_LANGUAGE_DETECT_CONFIDENCE_THRESHOLD=0.70
# Perf debug timings in WS payload + JSON turn logs
PERF_DEBUG_TIMINGS=true

# Hardware Configuration
CAMERA_INDEX=0
MIC_DEVICE_INDEX=0

# Paths
FACES_DB_PATH=config/faces.dat
UI_CONFIG_PATH=config/ui_config.json
TEMP_DIR=./temp

# PostgreSQL + pgvector (RAG storage). Required for college knowledge retrieval. Bind to localhost only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=clara_db
POSTGRES_USER=clara_user
# Required: set a strong password. Never commit .env.
POSTGRES_PASSWORD=

# RAG Configuration (college knowledge retrieval). RAG_MODEL must match a current Groq model id (see https://console.groq.com/docs/models); 404 usually means wrong or deprecated model.
RAG_MAX_TOKENS=6000
RAG_MODEL=llama-3.1-8b-instant
COLLEGE_KNOWLEDGE_PATH=college_knowledge.txt
RAG_TOP_K=5

# State Machine Configuration
INACTIVITY_TIMEOUT=20.0

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SILENCE_STOP_MS=600
AUDIO_MAX_UTTERANCE_MS=7000
STT_MIN_CONFIDENCE=0.60
STT_MIN_TRANSCRIPT_CHARS=6
STT_MIN_TRANSCRIPT_TOKENS=2
STT_MAX_QUALITY_RETRIES=1

# LLM latency controls
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.2
LLM_STREAM_PARTIAL_DEBOUNCE_MS=120
LLM_STREAM_TIMEOUT_S=12.0
RAG_CONTEXT_TIMEOUT_S=2.5

# Shared HTTP client tuning
HTTP_TIMEOUT_CONNECT_S=2.0
HTTP_TIMEOUT_READ_S=15.0
HTTP_TIMEOUT_WRITE_S=15.0
HTTP_TIMEOUT_POOL_S=2.0
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_MAX_CONNECTIONS=50
HTTP_KEEPALIVE_EXPIRY_S=30.0
HTTP_RETRY_ATTEMPTS=1

# Server Configuration
HOST=0.0.0.0
PORT=6969
FRONTEND_URL=http://localhost:5176
